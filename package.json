{
  "name": "hse-quest",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "HSE Quest (working name: Separ) — fully offline HSE skills game app",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:offline": "node scripts/verify-offline.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run verify:offline && npm run verify:version",
    "cap:add": "cap add android",
    "cap:sync": "node scripts/sync-version.mjs && npm run build && node scripts/verify-offline.mjs --require-dist && cap sync android",
    "cap:open": "cap open android",
    "e2e": "npm run build && node tests/e2e/playthrough.mjs",
    "perf": "npm run build && node tests/e2e/perf.mjs",
    "assets:android": "node scripts/generate-android-assets.mjs",
    "verify:merged": "node scripts/merged-manifest.mjs",
    "verify:version": "node scripts/sync-version.mjs --check",
    "content:export": "node scripts/content-review.mjs export",
    "content:apply": "node scripts/content-review.mjs apply",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "dexie": "^4.4.6",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
